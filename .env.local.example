# Copier vers .env.local (jamais commité) et remplir avec les valeurs de
# Settings → API sur dashboard.supabase.com. NEXT_PUBLIC_* est exposé au
# navigateur — n'y mettre que l'URL et la clé "Publishable" (ex-anon).
# La clé "Secret" (ex-service_role) ne doit JAMAIS avoir de préfixe
# NEXT_PUBLIC_ et ne doit être utilisée que côté serveur (Vercel env vars).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé Secret (ex-service_role) — CONTOURNE TOUTE RLS. Utilisée uniquement
# côté serveur (src/lib/supabase/admin.ts, Server Actions déjà protégées
# par une vérification de rôle Admin). JAMAIS de préfixe NEXT_PUBLIC_ ici.
# À définir aussi dans les variables d'environnement Vercel (jamais commitée).
SUPABASE_SERVICE_ROLE_KEY=
